<div id="landingContainer" style="display: none;">

    <div id="hootSidebar">
        <div class="corner-tl"></div>
        <div class="corner-tr"></div>
        <div class="corner-bl"></div>
        <div class="corner-br"></div>

        <div id="hootLogoArea">
            <div id="image_seal_container">
                <img id="image_seal" src="assets/images/logo.png"/>
                <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
            </div>
            <div id="hootTitle">HOOT CLIENT</div>
            <div id="hootTitleDivider">
                <span class="divider-line"></span>
                <span class="divider-gem">◆</span>
                <span class="divider-line"></span>
            </div>
        </div>

        <nav id="hootNav">
            <button id="hootPlayBtn" onclick="document.getElementById('launch_button').click()">
                <span class="nav-icon">▶</span>
                <span class="nav-text">JOGAR</span>
            </button>
            <button class="hootNavItem" id="settingsMediaButton">
                <span class="nav-icon">⚙</span>
                <span class="nav-text">CONFIGURAÇÕES</span>
            </button>
        </nav>
        <span id="user_text" style="display:none;"><%- lang('landing.usernamePlaceholder') %></span>
        <div class="sidebar-divider">
            <span class="divider-line"></span>
            <span class="divider-gem">◆</span>
            <span class="divider-line"></span>
        </div>

        <div id="sidebarGear">
            <div class="gear-outer">
                <div class="gear-tooth t1"></div><div class="gear-tooth t2"></div>
                <div class="gear-tooth t3"></div><div class="gear-tooth t4"></div>
                <div class="gear-tooth t5"></div><div class="gear-tooth t6"></div>
                <div class="gear-tooth t7"></div><div class="gear-tooth t8"></div>
                <div class="gear-inner"><div class="gear-core"></div></div>
            </div>
        </div>

        <div id="hootVersion">v2.2.1</div>

        <div id="hootSocialIcons">
